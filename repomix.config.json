{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "style": "xml",
    "filePathStyle": "cwd-relative",
    "parsableStyle": true,
    "compress": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "truncateBase64": true,
    "git": {
      "sortByChanges": false,
      "includeDiffs": true,
      "includeLogs": false
    }
  },
  "security": {
    "enableSecurityCheck": true
  }
}